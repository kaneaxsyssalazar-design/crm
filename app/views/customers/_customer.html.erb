<div class="box customer-card">
  <article class="media">
    <figure class="media-left">
      <div class="customer-photo-wrap">
        <% if customer.image.attached? %>
          <%= image_tag customer.image, alt: customer.full_name, class: "customer-photo" %>
        <% else %>
          <span class="customer-photo customer-photo--blank"><%= customer.full_name.to_s.first.to_s.upcase %></span>
        <% end %>
      </div>
    </figure>
    <div class="media-content">
      <div class="content">
        <p class="title is-5 mb-1"><%= customer.full_name %></p>
        <p class="mb-1"><strong>Phone:</strong> <%= customer.phone_number %></p>
        <p class="mb-1">
          <strong>Email:</strong>
          <% if customer.email_address.present? %>
            <%= mail_to customer.email_address %>
          <% else %>
            <em class="has-text-grey">No email on file</em>
          <% end %>
        </p>
        <% if customer.notes.present? %>
          <p class="mb-0"><strong>Notes:</strong> <%= customer.notes %></p>
        <% end %>
      </div>
    </div>
  </article>
</div>